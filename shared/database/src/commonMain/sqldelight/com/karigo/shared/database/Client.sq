CREATE TABLE client (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    phone TEXT NOT NULL DEFAULT '',
    email TEXT NOT NULL DEFAULT '',
    address TEXT NOT NULL DEFAULT '',
    notes TEXT NOT NULL DEFAULT '',
    outstanding_balance REAL NOT NULL DEFAULT 0.0,
    total_jobs INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

getgAallClients:
SELECT * FROM client ORDER BY name ASC ;

getClientById:
SELECT * FROM client WHERE id = ?;

searchClient:
SELECT * FROM client WHERE name LIKE '%' || ? || '%'
OR phone LIKE '%' || ? || '%' ORDER BY name ASC;

getClientWithOutstanding:
SELECT * FROM client WHERE outstanding_balance > 0 ORDER BY outstanding_balance DESC;

insertClient:
INSERT INTO client(id, name, phone, email, address, notes, total_jobs, created_at, updated_at)
VALUES (?,?,?,?,?,?,?,?,?);

updateClient:
UPDATE client SET name = ?, phone = ?, email = ?, address = ?, notes = ?, updated_at = ? WHERE id = ?;

updateOutstanding:
UPDATE client SET outstanding_balance = ?, updated_at = ?  WHERE id =?;

incrementJobCount:
UPDATE client SET total_jobs = total_jobs+1 WHERE id =?;

deleteClient:
DELETE FROM client WHERE  id =? ;