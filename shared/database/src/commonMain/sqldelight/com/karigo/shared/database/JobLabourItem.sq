CREATE TABLE job_labour_item (

    id TEXT PRIMARY KEY NOT NULL,
    job_id TEXT NOT NULL REFERENCES job(id) ON DELETE CASCADE,
    description TEXT NOT NULL,
    hours REAL NOT NULL DEFAULT 0.0,
    quantity INTEGER NOT NULL DEFAULT 0,
    rate REAL NOT NULL DEFAULT 0.0,
    total REAL NOT NULL DEFAULT 0.0, -- hours x rate or quantity x rate
    created_at INTEGER NOT NULL
);

-------- READ----------

getLabourItemsByJob:
SELECT * FROM job_labour_item WHERE job_id =? ORDER BY created_at;

-------- WRITE----------
insertLabourItemsByJob:
INSERT INTO job_labour_item(id, job_id, description, hours, quantity, rate, total, created_at)
VALUES (?,?,?,?,?,?,?,?);

updateLabourItem:
UPDATE job_labour_item SET description = ? , hours = ?, rate = ?, total = ? WHERE id = ?;

deleteLabourItem:
DELETE FROM job_labour_item WHERE id =?;

deleteLabourItemByJob:
DELETE FROM job_labour_item WHERE job_id = ?;

sumLabourByJob:
SELECT COALESCE(SUM(total), 0.0) FROM job_labour_item WHERE job_id =?;
