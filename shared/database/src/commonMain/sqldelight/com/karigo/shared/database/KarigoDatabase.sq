import kotlin.time.Instant;

CREATE TABLE materials(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    unit TEXT NOT NULL,
    price REAL NOT NULL,
    trade_type TEXT NOT NULL,
    created_at INTEGER AS Instant NOT NULL
);

selectAllMaterials:
SELECT * FROM materials;

selectMaterialByTrade:
SELECT * FROM materials WHERE trade_type = ?;

selectMaterialById:
SELECT * FROM materials WHERE id = ?;

insertMaterial:
INSERT OR REPLACE INTO materials(name, unit, price, trade_type,created_at) VALUES (?, ?, ?, ?, ?);

deleteMaterialById:
DELETE FROM materials WHERE id = ?;

updateMaterial:
UPDATE materials SET name = ?, unit = ?, price = ?, trade_type = ? WHERE id = ?;

