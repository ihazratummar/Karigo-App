import kotlin.time.Instant;

CREATE TABLE materials(
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    unit TEXT NOT NULL,
    rate REAL NOT NULL,
    trade_type TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

getAllMaterials:
SELECT * FROM materials ORDER BY name;

selectMaterialById:
SELECT * FROM materials WHERE id = ?;

selectMaterialByTrade:
SELECT * FROM materials WHERE trade_type = ?;

searchMaterials:
SELECT * FROM materials
WHERE (name LIKE '%'||:query||'%')
AND (trade_type IN :tradeTypes OR :tradeTypesCount = 0)
ORDER BY name;

insertMaterial:
INSERT OR REPLACE INTO materials(id, name, unit, rate, trade_type,created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?,?);

updateMaterial:
UPDATE materials SET name = ?, unit = ?, rate = ?, trade_type = ?, updated_at = ? WHERE id = ?;

deleteMaterialById:
DELETE FROM materials WHERE id = ?;

