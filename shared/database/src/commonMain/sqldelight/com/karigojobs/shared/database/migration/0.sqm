import kotlin.Boolean;

-- Initial Schema (Version 0)

CREATE TABLE client (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    phone TEXT NOT NULL DEFAULT '',
    email TEXT NOT NULL DEFAULT '',
    address TEXT NOT NULL DEFAULT '',
    outstanding_balance REAL NOT NULL DEFAULT 0.0,
    total_jobs INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE job (
    id TEXT PRIMARY KEY NOT NULL,
    client_id TEXT NOT NULL REFERENCES client(id) ON DELETE CASCADE,
    title TEXT NOT NULL,
    decription TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL DEFAULT 'Pending',
    trade_type TEXT NOT NULL DEFAULT 'PLUMBER',
    material_total REAL NOT NULL DEFAULT 0.0,
    total REAL NOT NULL DEFAULT 0.0,
    notes TEXT NOT NULL DEFAULT '',
    total_items INTEGER NOT NULL DEFAULT 0,
    job_date INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE materials(
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    unit TEXT NOT NULL,
    rate REAL NOT NULL,
    trade_type TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE job_material (
    id TEXT PRIMARY KEY NOT NULL,
    job_id TEXT NOT NULL REFERENCES job(id) ON DELETE CASCADE,
    material_id TEXT,
    name TEXT NOT NULL,
    unit TEXT NOT NULL,
    unit_price REAL NOT NULL,
    quantity INTEGER NOT NULL,
    total REAL NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE job_labour_item (
    id TEXT PRIMARY KEY NOT NULL,
    job_id TEXT NOT NULL REFERENCES job(id) ON DELETE CASCADE,
    description TEXT NOT NULL,
    quantity INTEGER NOT NULL DEFAULT 1,
    rate REAL NOT NULL DEFAULT 0.0,
    unit TEXT NOT NULL DEFAULT 'point',
    total REAL NOT NULL DEFAULT 0.0,
    created_at INTEGER NOT NULL
);


CREATE TABLE site_estimate (
    id TEXT PRIMARY KEY NOT NULL,
    client_id TEXT NOT NULL REFERENCES client(id) ON DELETE  CASCADE ,
    project_title TEXT NOT NULL,
    date INTEGER NOT NULL,
    site_notes TEXT,
    show_rate INTEGER AS Boolean NOT NULL DEFAULT 0,
    total REAL,
    create_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);