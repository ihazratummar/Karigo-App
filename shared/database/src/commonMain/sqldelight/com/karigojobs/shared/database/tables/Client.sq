CREATE TABLE client (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    phone TEXT NOT NULL DEFAULT '',
    email TEXT NOT NULL DEFAULT '',
    address TEXT NOT NULL DEFAULT '',
    outstanding_balance REAL NOT NULL DEFAULT 0.0,
    total_paid REAL NOT NULL DEFAULT 0.0,
    total_revenue REAL NOT NULL DEFAULT 0.0,
    pending_amount REAL NOT NULL DEFAULT 0.0,
    total_jobs INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

getAllClients:
SELECT * FROM client ORDER BY name ASC ;

getClientById:
SELECT * FROM client WHERE id = ?;

searchClient:
SELECT * FROM client WHERE name LIKE '%' || :query || '%' COLLATE NOCASE
OR phone LIKE '%' || :query || '%' COLLATE NOCASE ORDER BY outstanding_balance DESC ;

getClientByPhone:
SELECT * FROM client WHERE  phone = ?;

getClientWithOutstanding:
SELECT * FROM client WHERE outstanding_balance > 0 ORDER BY outstanding_balance DESC;

getTotalOutstanding:
SELECT COALESCE(SUM(outstanding_balance), 0.0) AS total_outstanding FROM client;

insertClient:
INSERT INTO client(id, name, phone, email, address, outstanding_balance, total_paid, total_revenue, pending_amount, total_jobs, created_at, updated_at)
VALUES (?,?,?,?,?,?,?,?,?,?,?,?);

updateClient:
UPDATE client SET name = ?, phone = ?, email = ?, address = ? , updated_at = ? WHERE id = ?;

updateOutstanding:
UPDATE client SET outstanding_balance = ?, updated_at = ?  WHERE id =?;

adjustOutstanding:
UPDATE client SET outstanding_balance = outstanding_balance + :amount, updated_at = :updatedAt WHERE id = :id;

adjustClientFinances:
UPDATE client
SET total_revenue = total_revenue + :revenueDelta,
    total_paid = total_paid + :paidDelta,
    outstanding_balance = outstanding_balance + :outstandingDelta,
    pending_amount = pending_amount + :pendingDelta,
    updated_at = :updatedAt
WHERE id = :id;

incrementJobCount:
UPDATE client SET total_jobs = total_jobs+1 WHERE id =?;

decrementJobCount:
UPDATE client SET total_jobs = CASE WHEN total_jobs > 0 THEN total_jobs - 1 ELSE 0 END WHERE id = ?;

deleteClient:
DELETE FROM client WHERE  id =? ;