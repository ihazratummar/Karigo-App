CREATE TABLE job_labour_item (

    id TEXT PRIMARY KEY NOT NULL,
    job_id TEXT NOT NULL REFERENCES job(id) ON DELETE CASCADE,
    description TEXT NOT NULL,
    quantity INTEGER NOT NULL DEFAULT 1,
    workers_count INTEGER NOT NULL DEFAULT 1,
    rate REAL NOT NULL DEFAULT 0.0,
    unit TEXT NOT NULL DEFAULT 'point',
    total REAL NOT NULL DEFAULT 0.0, -- workers_count * quantity * rate
    created_at INTEGER NOT NULL
);

-------- READ----------

getLabourItemsByJob:
SELECT * FROM job_labour_item WHERE job_id =? ORDER BY created_at;

-------- WRITE----------
insertLabourItemsByJob:
INSERT INTO job_labour_item(id, job_id, description, quantity, workers_count, rate, unit, total, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateLabourQuantity:
UPDATE job_labour_item SET quantity = ? WHERE  id =?;

updateLabourWorkersCount:
UPDATE job_labour_item SET workers_count = ? WHERE id =?;

updateLabourItem:
UPDATE job_labour_item SET description = ?, quantity = ?, workers_count = ?, rate = ?, unit = ?, total = ? WHERE id = ?;

deleteLabourItem:
DELETE FROM job_labour_item WHERE id =?;

deleteLabourItemByJob:
DELETE FROM job_labour_item WHERE job_id = ?;

sumLabourByJob:
SELECT COALESCE(SUM(total), 0.0) FROM job_labour_item WHERE job_id =?;
