CREATE TABLE materials(
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    unit TEXT NOT NULL,
    rate REAL NOT NULL,
    trade_type TEXT NOT NULL,
    category_id TEXT REFERENCES MaterialCategory(id) ON DELETE SET NULL ,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

getAllMaterials:
SELECT * FROM materials ORDER BY name;

selectMaterialById:
SELECT * FROM materials WHERE id = ?;

selectMaterialByTrade:
SELECT * FROM materials WHERE trade_type = ?;

searchMaterials:
SELECT m.*, c.name AS category_name
FROM materials m
LEFT JOIN MaterialCategory c ON m.category_id = c.id
WHERE (m.name LIKE '%'||:query||'%')
AND (m.trade_type IN :tradeTypes OR :tradeTypesCount = 0)
AND (m.category_id = :categoryId OR :categoryId IS NULL)
ORDER BY m.name;

insertMaterial:
INSERT OR REPLACE INTO materials(id, name, unit, rate, trade_type, category_id, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateMaterial:
UPDATE materials SET name = ?, unit = ?, rate = ?, trade_type = ?, category_id = ?, updated_at = ? WHERE id = ?;

deleteMaterialById:
DELETE FROM materials WHERE id = ?;

