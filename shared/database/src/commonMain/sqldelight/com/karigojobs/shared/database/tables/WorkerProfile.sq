CREATE TABLE worker_profile (

    id INTEGER PRIMARY KEY DEFAULT 1 CHECK (id = 1),
    business_name TEXT NOT NULL DEFAULT '',
    owner_name TEXT NOT NULL DEFAULT '',
    address TEXT NOT NULL DEFAULT '',
    phone TEXT NOT NULL DEFAULT '',
    email TEXT NOT NULL DEFAULT '',
    gst_number TEXT NOT NULL DEFAULT '',
    logo_path TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

getProfile:
SELECT  * FROM worker_profile WHERE id = 1;

updateProfile:
INSERT OR REPLACE INTO worker_profile
(id, business_name, owner_name, address, phone, email, gst_number, logo_path, created_at, updated_at)
VALUES (1, ?,?,?,?,?,?,?,?,?);

updateBusinessName:
UPDATE worker_profile SET business_name = ?, updated_at = ? WHERE id = 1;

updateLogo:
UPDATE worker_profile SET logo_path = ? , updated_at = ? WHERE id=1;