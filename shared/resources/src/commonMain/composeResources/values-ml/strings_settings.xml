    <!-- About Screen -->
    <string name="about_title">കരിഗോയെക്കുറിച്ച്</string>
    <string name="about_version">പതിപ്പ് %1$s (%2$d)</string>
    <string name="about_logo_description">കരിഗോ ലോഗോ</string>
    <string name="about_tagline">കോൺട്രാക്ടർമാർക്കും സേവന പ്രൊഫഷണലുകൾക്കും തൊഴിലാളികൾക്കുമുള്ള ഓൾ-ഇൻ-വൺ ബിസിനസ്സ് പങ്കാളി.</string>
    <string name="about_section_what_does">കരിഗോ എന്ത് ചെയ്യുന്നു</string>
    <string name="about_what_does_desc">പേപ്പർ വർക്കുകളുടെയോ സങ്കീർണ്ണമായ സ്പ്രെഡ്ഷീറ്റുകളുടെയോ ബുദ്ധിമുട്ടില്ലാതെ നിങ്ങളുടെ ഫോണിൽ നിന്ന് തന്നെ കോൺട്രാക്റ്റിംഗ് അല്ലെങ്കിൽ സേവന ബിസിനസ്സ് നടത്താൻ കരിഗോ നിങ്ങളെ സഹായിക്കുന്നു. ജോലികൾ മാനേജ് ചെയ്യുക, ക്ലയൻ്റുകളുടെ വിവരങ്ങൾ സൂക്ഷിക്കുക, നിങ്ങളുടെ സാമഗ്രികളുടെയും നിരക്കുകളുടെയും ഒരു ലൈബ്രറി നിർമ്മിക്കുക, തൽക്ഷണം പ്രൊഫഷണൽ സൈറ്റ് എസ്റ്റിമേറ്റുകൾ തയ്യാറാക്കുക, വാട്സ്ആപ്പ് വഴി എല്ലാം പങ്കിടുക.</string>
    <string name="about_section_features">പ്രധാന സവിശേഷതകൾ</string>
    <string name="about_feature_job_title">ജോലി മാനേജ്മെൻ്റ്</string>
    <string name="about_feature_job_desc">തുടക്കം മുതൽ അവസാന പെയ്മെൻ്റ് വരെയുള്ള ജോലികൾ ട്രാക്ക് ചെയ്യുക</string>
    <string name="about_feature_client_title">ക്ലയൻ്റ് ഡയറക്ടറി</string>
    <string name="about_feature_client_desc">ഉപഭോക്തൃ കോൺടാക്റ്റ് വിവരങ്ങളും ചരിത്രവും സുരക്ഷിതമായി സൂക്ഷിക്കുക</string>
    <string name="about_feature_material_title">മെറ്റീരിയൽ ലൈബ്രറി</string>
    <string name="about_feature_material_desc">വേഗത്തിലുള്ള ഉപയോഗത്തിനായി നിങ്ങളുടെ സാധാരണ മെറ്റീരിയലുകളും വിലകളും സേവ് ചെയ്യുക</string>
    <string name="about_feature_estimate_title">സൈറ്റ് എസ്റ്റിമേറ്റുകൾ</string>
    <string name="about_feature_estimate_desc">സൈറ്റിൽ വെച്ച് തന്നെ വിശദമായ ക്വട്ടേഷനുകൾ തയ്യാറാക്കി തൽക്ഷണം അയക്കുക</string>
    <string name="about_feature_earning_title">വരുമാനം ട്രാക്ക് ചെയ്യുക</string>
    <string name="about_feature_earning_desc">നിങ്ങളുടെ മൊത്തം വരുമാനവും കിട്ടാനുള്ള തുകയും നിരീക്ഷിക്കുക</string>
    <string name="about_feature_backup_desc">നിങ്ങളുടെ ഡാറ്റ ബാക്കപ്പ് ചെയ്യുന്നതിനും എപ്പോൾ വേണമെങ്കിലും റിസ്റ്റോർ ചെയ്യുന്നതിനും Google Drive ലിങ്ക് ചെയ്യുക</string>
    <string name="about_section_who_for">ഇത് ആർക്കാണ്</string>
    <string name="about_who_for_desc">നമ്മുടെ ലോകം നിർമ്മിക്കുകയും ഇൻസ്റ്റാൾ ചെയ്യുകയും അറ്റകുറ്റപ്പണികൾ നടത്തുകയും സംരക്ഷിക്കുകയും ചെയ്യുന്ന കഠിനാധ്വാനികളായ പ്രൊഫഷണലുകൾക്ക് വേണ്ടിയാണ് കരിഗോ നിർമ്മിച്ചിരിക്കുന്നത്:</string>
    <string name="about_section_made_pride">അഭിമാനത്തോടെ നിർമ്മിച്ചത്</string>
    <string name="about_made_pride_desc">കോൺട്രാക്റ്റ് ജോലിയുടെ യാഥാർത്ഥ്യം മനസ്സിൽ വെച്ചുകൊണ്ട് രൂപകൽപ്പന ചെയ്തത് — മൾട്ടി-കറൻസി സപ്പോർട്ട്, വാട്സ്ആപ്പ് ഷെയറിംഗ്, ഓഫ്‌ലൈൻ കഴിവുകൾ, ലളിതമായ ഇൻ്റർഫേസ്.</string>
