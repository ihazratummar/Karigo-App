    <!-- About Screen -->
    <string name="about_title">Karigo बद्दल</string>
    <string name="about_version">आवृत्ती %1$s (%2$d)</string>
    <string name="about_logo_description">Karigo लोगो</string>
    <string name="about_tagline">कंत्राटदार, सेवा व्यावसायिक आणि कारागिरांसाठी ऑल-इन-वन व्यावसायिक भागीदार.</string>
    <string name="about_section_what_does">Karigo काय करतो</string>
    <string name="about_what_does_desc">Karigo तुम्हाला कागदपत्रांच्या किंवा क्लिष्ट स्प्रेडशीट्सच्या त्रासाशिवाय थेट तुमच्या फोनवरून कंत्राटी किंवा सेवा व्यवसाय चालवण्यास मदत करतो. कामे व्यवस्थापित करा, ग्राहकांचे रेकॉर्ड ठेवा, साहित्य आणि दरांची लायब्ररी तयार करा, जागेवरच व्यावसायिक साइटचे अंदाज तयार करा आणि व्हॉट्सॲपद्वारे थेट शेअर करा.</string>
    <string name="about_section_features">प्रमुख वैशिष्ट्ये</string>
    <string name="about_feature_job_title">काम व्यवस्थापन</string>
    <string name="about_feature_job_desc">कामाच्या सुरुवातीपासून अंतिम देयकापर्यंतचा मागोवा घ्या</string>
    <string name="about_feature_client_title">ग्राहक सूची</string>
    <string name="about_feature_client_desc">ग्राहकांचे संपर्क तपशील आणि कामाचा इतिहास सुरक्षितपणे साठवा</string>
    <string name="about_feature_material_title">साहित्य लायब्ररी</string>
    <string name="about_feature_material_desc">झटपट वापरासाठी तुमचे प्रमाणित साहित्य आणि किंमती जतन करा</string>
    <string name="about_feature_estimate_title">സൈറ്റ് എസ്റ്റിമേറ്റുകൾ</string>
    <string name="about_feature_estimate_desc">साइटवरच सविस्तर कोटेशन तयार करा आणि त्वरित पाठवा</string>
    <string name="about_feature_earning_title">कमाईचा मागोवा</string>
    <string name="about_feature_earning_desc">तुमच्या एकूण कमाईवर आणि थकीत देयकांवर लक्ष ठेवा</string>
    <string name="about_feature_backup_desc">तुमचा डेटा बॅकअप घेण्यासाठी आणि तो कधीही रिस्टोर करण्यासाठी गुगल ड्राइव्ह लिंक करा</string>
    <string name="about_section_who_for">हे कोणासाठी आहे</string>
    <string name="about_who_for_desc">Karigo अशा मेहनती व्यावसायिकांसाठी बनवला आहे जे आपल्या जगाचे निर्माण, दुरुस्ती आणि देखभाल करतात:</string>
    <string name="about_section_made_pride">अभिमानाने बनवलेला</string>
    <string name="about_made_pride_desc">कंत्राटी कामाची वास्तविकता लक्षात घेऊन डिझाइन केलेले — बहु-चलन सपोर्ट, व्हॉट्सॲप शेअरिंग, ऑफलाईन क्षमता आणि सोपे इंटरफेस.</string>
