    <string name="about_feature_client_title">ग्राहक सूची</string>
    <string name="about_feature_client_desc">ग्राहकांचे संपर्क तपशील आणि कामाचा इतिहास सुरक्षितपणे साठवा</string>
    <string name="about_feature_material_title">साहित्य लायब्ररी</string>
    <string name="about_feature_material_desc">झटपट वापरासाठी तुमचे प्रमाणित साहित्य आणि किंमती जतन करा</string>
