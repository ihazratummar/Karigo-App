    <!-- About Screen -->
    <string name="about_title">கரிகோ பற்றி</string>
    <string name="about_version">பதிப்பு %1$s (%2$d)</string>
    <string name="about_logo_description">கரிகோ சின்னம்</string>
    <string name="about_tagline">ஒப்பந்ததாரர்கள், சேவை வல்லுநர்கள் மற்றும் தொழிலாளர்களுக்கான அனைத்தையும் உள்ளடக்கிய வணிக கூட்டாளர்.</string>
    <string name="about_section_what_does">கரிகோ என்ன செய்கிறது</string>
    <string name="about_what_does_desc">காகித வேலைகள் அல்லது சிக்கலான விரிதாள்களின் தொந்தரவு இல்லாமல் உங்கள் தொலைபேசியிலிருந்தே ஒப்பந்தம் அல்லது சேவை வணிகத்தை நடத்த கரிகோ உங்களுக்கு உதவுகிறது. வேலைகளை நிர்வகிக்கவும், வாடிக்கையாளர் பதிவுகளை வைத்திருக்கவும், உங்கள் பொருட்கள் மற்றும் விலைகளின் நூலகத்தை உருவாக்கவும், இடத்திலேயே தொழில்முறை தள மதிப்பீடுகளை உருவாக்கவும், மற்றும் வாட்ஸ்அப் மூலம் எல்லாவற்றையும் நேரடியாகப் பகிரவும்.</string>
    <string name="about_section_features">முக்கிய அம்சங்கள்</string>
    <string name="about_feature_job_title">வேலை மேலாண்மை</string>
    <string name="about_feature_job_desc">தொடக்கம் முதல் இறுதி கட்டணம் வரை வேலையை கண்காணிக்கவும்</string>
    <string name="about_feature_client_title">வாடிக்கையாளர் அடைவு</string>
    <string name="about_feature_client_desc">வாடிக்கையாளர் தொடர்பு விவரங்கள் &amp; வரலாற்றை பாதுகாப்பாக சேமிக்கவும்</string>
    <string name="about_feature_material_title">பொருள் நூலகம்</string>
    <string name="about_feature_material_desc">விரைவான மறுபயன்பாட்டிற்காக உங்கள் நிலையான பொருட்கள் &amp; விலையை சேமிக்கவும்</string>
    <string name="about_feature_estimate_title">தள மதிப்பீடுகள்</string>
    <string name="about_feature_estimate_desc">தளத்திலேயே விரிவான மேற்கோள்களை உருவாக்கி உடனடியாக அனுப்பவும்</string>
    <string name="about_feature_earning_title">வருவாய் கண்காணிப்பு</string>
    <string name="about_feature_earning_desc">உங்கள் மொத்த வருவாய் மற்றும் நிலுவையில் உள்ள கட்டணங்களை கண்காணிக்கவும்</string>
    <string name="about_feature_backup_desc">உங்கள் தரவை காப்புப் பிரதி எடுக்க கூகிள் டிரைவை இணைக்கவும் மற்றும் எப்போது வேண்டுமானாலும் மீட்டமைக்கவும்</string>
    <string name="about_section_who_for">இது யாருக்காக</string>
    <string name="about_who_for_desc">நமது உலகத்தை உருவாக்கும், நிறுவும், பழுதுபார்க்கும் மற்றும் பராமரிக்கும் கடின உழைப்பாளிகளுக்காக கரிகோ உருவாக்கப்பட்டுள்ளது:</string>
    <string name="about_section_made_pride">பெருமையுடன் உருவாக்கப்பட்டது</string>
    <string name="about_made_pride_desc">ஒப்பந்த வேலையின் யதார்த்தத்தை மனதில் கொண்டு வடிவமைக்கப்பட்டுள்ளது — பல நாணய ஆதரவு, வாட்ஸ்அப் பகிர்வு, ஆஃப்லைன் திறன்கள் மற்றும் எளிமையான இடைமுகம்.</string>
    <string name="about_copyright">Karigo v%1$s • அனைத்து உரிமைகளும் பாதுகாக்கப்பட்டவை</string>
